<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Light only) -->
    <style name="Base.Theme.Imu_slam" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#1a92a8</item>
        <item name="android:textColor">#000000</item>
        <item name="android:windowFullscreen">true</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item> <!-- Disable system dark mode -->
    </style>

    <style name="Theme.Imu_slam" parent="Base.Theme.Imu_slam" />

    <!-- Bottom Navigation styles -->
    <style name="BottomNavText.Small" parent="@style/TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="CustomBottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/BottomNavText.Small</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavText.Small</item>
        <item name="itemBackground">@drawable/nav_item_background_selector</item>
        <item name="itemIconTint">#ffffff</item>
        <item name="itemTextColor">#ffffff</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="itemIconSize">18dp</item>
    </style>

    <style name="TextAppearance.BottomNavigationView.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.BottomNavigationView.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="MyCustomButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">#ffffff</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MaterialComponents.SmallComponent</item>
        <item name="cornerRadius">16dp</item>
        <item name="textAllCaps">false</item>
        <item name="elevation">10dp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
</resources>
