<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/preprocess_map_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorOnPrimary_dark"
    tools:context=".PreprocessMap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="24dp">
<!--        <TextView-->
<!--            android:id="@+id/textView2"-->
<!--            android:layout_width="161dp"-->
<!--            android:gravity="start"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="Set Start Point" />-->

<!--        <ImageView-->

<!--            android:layout_width="161dp"-->
<!--            android:layout_height="25dp"-->
<!--            android:layout_gravity="center"-->
<!--            android:layout_marginTop="5dp"-->
<!--            android:layout_marginBottom="20dp"-->
<!--            android:contentDescription="pro"-->
<!--            android:scaleType="fitXY"-->
<!--            tools:srcCompat="@drawable/p1" />-->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            android:layout_gravity="center"
            android:padding="5dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true">

            <ImageView
                android:id="@+id/mapImageView"
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:contentDescription="Map image"
                android:scaleType="fitXY"
                tools:srcCompat="@drawable/new_map" />
        </androidx.cardview.widget.CardView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/Choose_Map_Starting_Point"
            android:textAllCaps="false"
            android:textSize="24dp" />

<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginBottom="8dp"-->
<!--            android:gravity="center"-->
<!--            android:paddingBottom="2dp"-->
<!--            android:text="@string/click_on_map_to_set_starting_point_move_to_starting_point"-->
<!--            android:textSize="16sp" />-->

        <TextView
            android:id="@+id/map_coordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text=" "
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/startButton"
            style="@style/MyCustomButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/start_button_bg"
            android:elevation="8dp"
            android:drawableStart="@drawable/ic_arrow_right"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:paddingStart="55dp"
            android:paddingTop="12dp"
            android:paddingEnd="55dp"
            android:paddingBottom="12dp"
            android:text="@string/Start"
            android:textAllCaps="false"
            android:textColor="@color/colorOnPrimary_dark"
            android:textSize="20sp"
            android:visibility="gone" />




    </LinearLayout>
</FrameLayout>