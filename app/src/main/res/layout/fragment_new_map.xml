<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".NewMap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:gravity="center"
        android:layout_gravity="center"
        android:paddingTop="24dp">

        <!-- Top Text -->
<!--        <TextView-->
<!--            android:id="@+id/import_map_title"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="Import New Map"-->
<!--            android:textSize="20sp"-->
<!--            android:textStyle="bold"-->
<!--            android:paddingBottom="16dp"-->
<!--            android:gravity="center" />-->
        <!-- Instructions Text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical"
            android:id="@+id/home_layout"
            android:padding="16dp"
            android:clipToPadding="false"
            android:clipChildren="false"

            android:gravity="start">

            <!-- Title -->
            <TextView
                android:id="@+id/new_map_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:paddingBottom="8dp"
                android:text="Welcome Back"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="start"
                android:text="Let's get started by importing a map."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <!-- Import New Map Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/import_map_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="true"
                app:cardElevation="6dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:padding="20dp">

                    <LinearLayout
                        android:id="@+id/import_map_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="start"
                        android:layout_centerInParent="true">

                        <ImageView
                            android:id="@+id/import_map_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/file_upload"
                            android:layout_gravity="center"
                            android:contentDescription="@string/Import_Map"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/import_map_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:autoSizeMaxTextSize="15sp"
                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="end"
                            android:gravity="start"
                            android:singleLine="true"
                            android:text="@string/Import_Map"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

                        <TextView
                            android:id="@+id/import_map_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="start"
                            android:text="Import New Map Image."
                            android:ellipsize="end"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="7sp"
                            android:autoSizeMaxTextSize="13sp"
                            android:autoSizeStepGranularity="1sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
                    </LinearLayout>

                    <!-- Right Arrow Icon -->
                    <ImageView
                        android:id="@+id/import_arrow"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="Next"
                       app:tint="?attr/colorPrimary"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Load Recent Map Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/load_recent_map_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="true"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <LinearLayout
                        android:id="@+id/load_map_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="start"
                        android:layout_centerInParent="true">

                        <ImageView
                            android:id="@+id/load_map_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/saved_file"
                            android:contentDescription="@string/Load_Recent_Map"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/load_map_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:autoSizeMaxTextSize="15sp"
                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="end"
                            android:gravity="start"
                            android:singleLine="true"
                            android:text="@string/Load_Recent_Map"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

                        <TextView
                            android:id="@+id/load_map_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="start"
                            android:text="Start with the last recent map."
                            android:ellipsize="end"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="7sp"
                            android:autoSizeMaxTextSize="13sp"
                            android:autoSizeStepGranularity="1sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
                    </LinearLayout>

                    <!-- Right Arrow Icon -->
                    <ImageView
                        android:id="@+id/load_arrow"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="Next"
                        app:tint="?attr/colorPrimary"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <androidx.cardview.widget.CardView
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/Dimension_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:id="@+id/Dimension_layout"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/dimension_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Enter_Map_Dimensions_in_Meters"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingBottom="12dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/height_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Enter_Maps_Height"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"/>

                <EditText
                    android:id="@+id/map_height"
                    android:layout_width="120dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:hint="@string/Height"
                    android:inputType="number"
                    android:textSize="12dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/width_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Enter_Maps_Width"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"/>

                <EditText
                    android:id="@+id/map_width"
                    android:layout_width="120dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:hint="@string/Width"
                    android:inputType="number"
                    android:textSize="12dp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/map_pos_activity_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Next"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp"
                    style="@style/MyCustomButtonStyle"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

