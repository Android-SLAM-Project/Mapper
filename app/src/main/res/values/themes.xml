<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Imu_slam" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
         <item name="colorPrimary">#1a92a8</item>
        <item name="android:textColor">#000000</item>
        <item name="android:windowFullscreen">true</item>

<!--        <item name="android:button">@style/MyCustomButtonStyle</item>-->
    </style>

    <style name="Theme.Imu_slam" parent="Base.Theme.Imu_slam" />
    <style name="CustomBottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/TextAppearance.BottomNavigationView.Inactive</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.BottomNavigationView.Inactive</item>
        <item name="itemBackground">@drawable/nav_item_background_selector</item>
        <item name="itemIconTint">#ffffff</item>
        <item name="itemTextColor">#ffffff</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="itemIconSize">24dp</item> <!-- Adjust icon size if needed -->
    </style>

    <style name="TextAppearance.BottomNavigationView.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item> <!-- Larger font for active item -->
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.BottomNavigationView.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item> <!-- Normal font for inactive items -->
    </style>
    <style name="MyCustomButtonStyle" parent="Widget.MaterialComponents.Button">
        <!-- Override only the text color -->
        <item name="android:textColor">#ffffff</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MaterialComponents.SmallComponent</item>
        <item name="cornerRadius">16dp</item>
        <item name="textAllCaps">false</item>
        <item name="elevation">10dp</item>
        <item name="android:letterSpacing">0.05</item>
        <!-- Keep all other properties as default -->
    </style>
</resources>