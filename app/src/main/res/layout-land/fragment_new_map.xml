<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NewMap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center"
        android:paddingTop="24dp">

        <!-- Top Text -->
<!--        <TextView-->
<!--            android:id="@+id/import_map_title"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="Import New Map"-->
<!--            android:textSize="20sp"-->
<!--            android:textStyle="bold"-->
<!--            android:paddingBottom="16dp"-->
<!--            android:gravity="center" />-->

        <!-- PArt 1 -->
        <!-- Instructions Text -->
        <TextView
            android:id="@+id/new_map_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Import_Map_Image_and_Define_Its_Parameters"
            android:textSize="14sp"
            android:paddingBottom="16dp"
            android:gravity="center" />

        <!-- Import Map Button -->
        <Button
            android:id="@+id/import_map_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Import_Map"
            android:padding="12dp"
            style="@style/MyCustomButtonStyle"
            android:layout_marginBottom="16dp"/>
        <Button
            android:id="@+id/resumeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Load_Recent_Map"
            android:padding="12dp"
            style="@style/MyCustomButtonStyle"
            android:layout_marginBottom="16dp"/>
<!--        <Button-->
<!--            android:id="@+id/resumeButton"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="@string/load_previous_map"-->
<!--            />-->



        <!-- PArt 2 -->
        <!-- Map Dimensions Text -->
        <TextView
            android:id="@+id/dimension_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Enter_Map_Dimensions_in_Meters"
            android:textSize="16sp"
            android:textStyle="bold"
        
            android:visibility="gone"
            android:gravity="center" />

        <!-- Horizontal layout for inputs and next button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="center">

            <!-- Height -->
            <TextView
                android:id="@+id/height_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Enter_Maps_Height"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                android:gravity="center"/>

            <EditText
                android:id="@+id/map_height"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:hint="@string/Height"
                android:inputType="number"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginEnd="16dp" />

            <!-- Width -->
            <TextView
                android:id="@+id/width_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Enter_Maps_Width"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                android:gravity="center"/>

            <EditText
                android:id="@+id/map_width"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:hint="@string/Width"
                android:inputType="number"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginEnd="16dp" />

            <!-- Next button -->
            <Button
                android:id="@+id/map_pos_activity_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Next"
                android:visibility="gone"
                android:padding="12dp"
                style="@style/MyCustomButtonStyle"/>
        </LinearLayout>



    </LinearLayout>
</FrameLayout>
