<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".NewMap">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:gravity="center"
        android:layout_gravity="center"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical"
            android:id="@+id/home_layout"
            android:padding="24dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:visibility="visible"
            android:gravity="start">

            <!-- Title -->
            <TextView
                android:id="@+id/new_map_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:paddingBottom="2dp"
                android:text="Welcome"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:gravity="start"
                android:text="Let's get started by importing a map."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- IMPORT CARD -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/import_map_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardUseCompatPadding="true"
                    app:cardPreventCornerOverlap="true"
                    app:cardElevation="4dp"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:minHeight="110dp">   <!-- ensures minimum visual height -->

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <!-- icon centered on top -->
                        <LinearLayout
                            android:id="@+id/import_map_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:id="@+id/import_map_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginBottom="6dp"
                                android:src="@drawable/file_upload"
                                android:contentDescription="@string/Import_Map"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/import_map_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/Import_Map"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/import_map_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Import New Map Image."
                                android:textSize="12sp"
                                android:gravity="center"
                                android:textColor="?android:attr/textColorSecondary" />
                        </LinearLayout>

                        <!-- arrow at the right edge, vertically centered -->
                        <ImageView
                            android:id="@+id/import_arrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_right"
                            android:contentDescription="Next"
                            app:tint="?attr/colorPrimary" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- LOAD RECENT CARD (mirror) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/load_recent_map_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardUseCompatPadding="true"
                    app:cardPreventCornerOverlap="true"
                    app:cardElevation="4dp"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:minHeight="110dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <LinearLayout
                            android:id="@+id/load_map_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:id="@+id/load_map_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginBottom="6dp"
                                android:src="@drawable/saved_file"
                                android:contentDescription="@string/Load_Recent_Map"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/load_map_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/Load_Recent_Map"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/load_map_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Start with the last recent map."
                                android:textSize="12sp"
                                android:gravity="center"
                                android:textColor="?android:attr/textColorSecondary" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/load_arrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_right"
                            android:contentDescription="Next"
                            app:tint="?attr/colorPrimary" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/Dimension_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"

            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:id="@+id/Dimension_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/dimension_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="12dp"
                    android:text="@string/Enter_Map_Dimensions_in_Meters"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="481dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="25dp"
                        android:gravity="start"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/height_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:gravity="center"
                            android:text="@string/Enter_Maps_Height" />

                        <EditText
                            android:id="@+id/map_height"
                            android:layout_width="120dp"
                            android:layout_height="50dp"
                            android:gravity="center"
                            android:hint="@string/Height"
                            android:inputType="number"
                            android:textSize="12dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="25dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/width_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:gravity="center"
                            android:text="@string/Enter_Maps_Width" />

                        <EditText
                            android:id="@+id/map_width"
                            android:layout_width="120dp"
                            android:layout_height="50dp"
                            android:gravity="center"
                            android:hint="@string/Width"
                            android:inputType="number"
                            android:textSize="12dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/map_pos_activity_button"
                        style="@style/MyCustomButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="25dp"
                        android:padding="12dp"
                        android:text="@string/Next" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</FrameLayout>
