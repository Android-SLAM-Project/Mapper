<?xml version="1.0" encoding="utf-8"?>
<!-- final focused style with outer ring (bigger than other circles) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- outer soft ring -->
    <item>
        <shape android:shape="oval">
            <size android:width="36dp" android:height="36dp"/>
            <solid android:color="@color/focusRing"/>
        </shape>
    </item>

    <!-- inner main filled circle -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <size android:width="28dp" android:height="28dp"/>
            <solid android:color="@color/stepFilled"/>
        </shape>
    </item>

    <!-- inner white dot -->
    <item android:width="12dp" android:height="12dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@android:color/white"/>
        </shape>
    </item>
</layer-list>
