<?xml version="1.0" encoding="utf-8"?>
<!-- filled primary circle with small white hole (layer-list ring effect) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- outer filled -->
    <item>
        <shape android:shape="oval">
            <size android:width="28dp" android:height="28dp"/>
            <solid android:color="@color/stepFilled"/>
        </shape>
    </item>

    <!-- inner white dot to create ring look -->
    <item android:width="16dp" android:height="16dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@android:color/white"/>
        </shape>
    </item>
</layer-list>
